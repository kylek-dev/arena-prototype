{
  "git-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/guard-commands.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "merge-conflict-check": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./hooks/stop-check.py",
        "timeout": 15
      }
    ]
  },
  "strict-check-on-stop": {
    "enabled": false,
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./hooks/stop-check.py --run-check",
        "timeout": 180
      }
    ]
  }
}
