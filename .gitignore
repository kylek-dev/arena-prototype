# Pixabay stock model: local use only; do not redistribute the raw download.
/assets/characters/pixellabs-undead-3417.glb

# Raw third-party texture downloads; prepared outputs in assets/textures are tracked.
/assets/textures/source/

# Generated icon masters (multi-MB JPEGs); prepared WebPs in assets/icons/spells are tracked.
/assets/icons/source/

# Quaternius packs: track only the CC0 sources scripts/quaternius_character.py
# reads, plus provenance and licenses. Other downloaded files stay local until
# the game uses them; add an exception here when integrating a new source.
/assets/quaternius/**
!/assets/quaternius/**/
!/assets/quaternius/README.md
!/assets/quaternius/base/License_Standard.txt
!/assets/quaternius/animation v1/License.txt
!/assets/quaternius/outfits/License_Standard.txt
!/assets/quaternius/animation v1/Unreal-Godot/UAL1_Standard.glb
!/assets/quaternius/base/Base Characters/Godot - UE/Superhero_Female_FullBody.gltf
!/assets/quaternius/base/Base Characters/Godot - UE/Superhero_Female_FullBody.bin
