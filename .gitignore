!/assets/quaternius/base/Base Characters/Godot - UE/Superhero_Male_FullBody.bin
!/assets/quaternius/base/Base Characters/Godot - UE/T_Hair_1_*.png
!/assets/quaternius/base/Base Characters/Godot - UE/T_Superhero_Male_*.png
