{
  "name": "arena-prototype-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs && vitest run",
    "test:input": "node --test tests/unit/*.test.mjs",
    "test:watch": "node scripts/watch-tests.mjs",
    "test:input:watch": "node --test --watch tests/unit/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint web/src tests/domain tests/ui",
    "format": "biome format --write web/src tests/domain tests/ui *.json *.ts",
    "format:check": "biome format web/src tests/domain tests/ui *.json *.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:browser": "playwright test",
    "serve": "vite preview --host 127.0.0.1 --port 8000"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/themes": "3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
