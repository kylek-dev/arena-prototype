# Copy to deploy/.env (ignored by Git) and fill in. Never commit the key.
#
# Public host players use, with :port when not 443. Caddy gets a certificate
# for it, so its DNS must point at this machine with ports 80 and 443 open.
ARENA_HOST=arena.example.com
ARENA_HTTPS_PORT=443
# Port 80 answers ACME HTTP challenges and redirects to HTTPS.
ARENA_HTTP_PORT=80
# Shared by the match server and the front door. Generate with:
#   openssl rand -hex 32
ARENA_TICKET_KEY=
