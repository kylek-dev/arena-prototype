# Copy to deploy/.env (ignored by Git) and fill in. Never commit the key.
#
# Public host players use, with :port when not 443. Caddy gets a certificate
# for it, so its DNS must point at this machine with ports 80 and 443 open.
ARENA_HOST=arena.example.com
ARENA_HTTPS_PORT=443
# Port 80 answers ACME HTTP challenges and redirects to HTTPS.
ARENA_HTTP_PORT=80
# Shared by the world server and the front door. Generate with:
#   openssl rand -hex 32
ARENA_TICKET_KEY=
#
# Accounts (ADR 0055), optional: leave ARENA_SESSION_KEY empty for guests
# only. A different key from ARENA_TICKET_KEY:
#   openssl rand -hex 32
ARENA_SESSION_KEY=
# The WorkOS application (dashboard.workos.com): its client id and API key.
# Its Redirects tab must list https://ARENA_HOST/api/auth/callback as a
# redirect URI and https://ARENA_HOST/ as the default sign-out URI.
ARENA_WORKOS_CLIENT_ID=
ARENA_WORKOS_API_KEY=
# Password of the accounts database (required by compose). Letters and
# digits only, since it goes into a URL:
#   openssl rand -hex 24
ARENA_IDENTITY_DB_PASSWORD=
# Admin account ids (hex, comma-separated), from /api/auth/me once logged in.
ARENA_ADMIN_ACCOUNTS=
