# TLS reverse proxy for remote playtests (ADR 0045). One origin serves the
# browser client, the front door (/lobby/, /api/) and match connections
# (/play). Caddy obtains and renews the certificate for ARENA_HOST itself.
# The match server's /metrics and /readyz are not exposed.
{$ARENA_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# HSTS only for a real host. A local trial gets certificates from Caddy's
	# own CA, renewed every few hours; under HSTS a browser that does not
	# trust that CA cannot click through the warning for the new one, and
	# its open match connections cannot reconnect (local trial, 2026-11-27).
	@public not host localhost 127.0.0.1 ::1
	header @public Strict-Transport-Security "max-age=31536000"

	@door path /api/* /lobby /lobby/*
	handle @door {
		reverse_proxy door:8090
	}

	handle /play {
		reverse_proxy server:8080 {
			# Close match connections no sooner than a round can last.
			stream_close_delay 21m
		}
	}

	handle {
		root * /srv/arena
		# Browsers revalidate every file (an unchanged one is a cheap 304):
		# the client's JS glue and WASM keep their names across builds and
		# must come from the same build, or the client fails to start.
		header Cache-Control no-cache
		file_server
	}

	# JSON access log, without the OAuth callback's one-time code and state
	# (ADR 0055); join tickets travel in fragments, which never reach here.
	log {
		output stdout
		format filter {
			request>uri query {
				delete code
				delete state
			}
		}
	}
}
